# meertex configuration. Copy to .env (`make config` does) and adjust.
#
# Read twice: by docker compose, which passes these into the container (see the
# `environment:` block in docker-compose.yml), and by app/config.py itself when
# the server runs natively (`make dev`). Every value is optional on a laptop.
# The defaults are the ones shown. Precedence is environment > .env > default.
# On Coolify none of this file is used. Set the variables in its UI instead
# (COOLIFY.md).

# --- The app ------------------------------------------------------------------

# Where the app is reachable from a browser. Sign-in links and invite mails are
# built from it. It has to match the published port (MEERTEX_PORT).
BASE_URL=http://localhost:8060

# Signs login codes. CHANGE THIS anywhere but your own laptop:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# --- Database -----------------------------------------------------------------

# For `make dev` and the tests: the compose database on the host's loopback.
# Inside the stack compose overrides this with the `db` service's address.
DATABASE_URL=postgresql+psycopg://meertex:meertex@localhost:5436/meertex

# The bundled Postgres. Change the password here and in DATABASE_URL together,
# and before the first `make up`. Postgres only reads it when it creates the
# database volume.
POSTGRES_USER=meertex
POSTGRES_PASSWORD=meertex
POSTGRES_DB=meertex
# 5436: meerail has 5432, meercal 5433, meerpic 5434 and meerpad 5435.
MEERTEX_DB_PORT=5436

# --- Container topology -------------------------------------------------------

# The port the stack publishes the app on, and the address it binds to.
# 127.0.0.1 unless a TLS proxy sits in front.
MEERTEX_PORT=8060
MEERTEX_BIND=127.0.0.1

# Every project's git history and binary files. Natively this is ./data.
# DATA_DIR=./data

# --- The live document ----------------------------------------------------------

# A file is text up to MAX_TEXT_BYTES and a blob above it. Blobs are capped at
# MAX_BLOB_BYTES. One sync message is at most MAX_SYNC_MESSAGE_BYTES.
MAX_TEXT_BYTES=2097152
MAX_BLOB_BYTES=52428800
MAX_SYNC_MESSAGE_BYTES=67108864
# A git snapshot runs SNAPSHOT_IDLE_SECONDS after the last edit, or
# SNAPSHOT_MAX_SECONDS after the first edit not yet committed. A room without
# connections is written out and dropped after ROOM_IDLE_SECONDS.
SNAPSHOT_IDLE_SECONDS=60
SNAPSHOT_MAX_SECONDS=600
ROOM_IDLE_SECONDS=300

# --- Compiling ------------------------------------------------------------------

# The compile service (compile/, docs/DESIGN.md §14). `make compile-dev` runs it
# natively on :8070 with this machine's TeX Live, for `make dev`. Empty turns
# compiling off. The compose stack points `web` at its own `compile` container
# and ignores COMPILE_URL here.
COMPILE_URL=http://127.0.0.1:8070
# Shared by the server and the compile service. CHANGE THIS anywhere but your
# own laptop. On Coolify it is a generated magic variable.
COMPILE_TOKEN=dev-compile-token
# A compile that runs longer is stopped. The newest COMPILE_KEEP_JOBS jobs stay
# with the service for SyncTeX. COMPILE_WORKERS compiles run at once.
COMPILE_TIMEOUT_SECONDS=90
COMPILE_KEEP_JOBS=30
COMPILE_WORKERS=2
# The compile container's limits (docker-compose*.yml).
COMPILE_MEMORY=2g
COMPILE_CPUS=2

# --- References -----------------------------------------------------------------

# The reference check (docs/DESIGN.md §16) looks entries up at doi.org,
# Crossref, Semantic Scholar, DBLP, arXiv and Open Library, and fetches links.
# false keeps only the checks that need no network.
REFERENCES_NETWORK=true
# The address the services see. Crossref answers faster with one. EMAIL_FROM
# when empty.
REFERENCES_MAILTO=
# Optional. Semantic Scholar's shared pool is slow without a key.
SEMANTIC_SCHOLAR_API_KEY=
# The claim check asks Claude whether a source supports a sentence. It is off
# without a key, and every check costs money.
ANTHROPIC_API_KEY=
REFERENCES_CLAUDE_MODEL=claude-opus-5-5

# --- Spelling and grammar -------------------------------------------------------

# The editor's spelling and grammar check (docs/DESIGN.md §17) asks a
# LanguageTool server. The compose stack runs its own `languagetool` service
# and uses it while this line stays commented out. Set it empty to turn the
# check off, and the editor keeps the browser's own spellchecker. `make dev`
# has no checker unless you start one on the host with
#   docker run -d -p 127.0.0.1:8011:8010 erikvl87/languagetool:6.8
# and set http://127.0.0.1:8011 here. Comment it out again before `make up`,
# because the containers cannot reach the host's loopback.
# GRAMMAR_URL=
# Seconds to wait for an answer. The first check in a language loads it.
GRAMMAR_TIMEOUT_SECONDS=20
# A GRAMMAR_URL host with a public address is refused, so unpublished papers
# do not leave the server by accident. true allows it.
GRAMMAR_ALLOW_PUBLIC_HOSTS=false
# Requests with LanguageTool at once, for the whole server.
GRAMMAR_MAX_CONCURRENT=3
# The languagetool container's memory limit (docker-compose*.yml).
LANGUAGETOOL_MEMORY=1536m

# --- Reminders ----------------------------------------------------------------

# The daily reminder mails before deadlines (docs/DESIGN.md §5, Reminders).
# Each person sets the days and the hour in Settings. false turns the loop
# off, for a laptop or a second copy of the app on the same database.
REMINDERS_ENABLED=true

# --- Email --------------------------------------------------------------------

# Sign-in is an emailed magic link plus a code (meerpad's flow). Leave
# SMTP_HOST empty and both are printed to the server log instead (`make logs`),
# which is all a laptop needs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=hello@meertex.com
# One mail to this address for every new account, at its first sign-in. It
# says who invited the person to which paper, or that they signed up on their
# own (docs/DESIGN.md §2, Accounts). Empty mails nobody.
NEW_USER_MAIL_TO=

# --- New accounts ----------------------------------------------------------

# Every account starts with an example paper at its first sign-in, with a
# venue, versions, a review and a bibliography with mistakes in it to try
# meertex on (docs/DESIGN.md §19). false makes none.
EXAMPLE_PAPER=true

# --- Instance admins -------------------------------------------------------

# Email addresses, separated by commas, whose accounts open the instance
# dashboard at /admin: accounts, papers and activity (docs/DESIGN.md §18).
# It gives no access to anybody's papers. Empty means nobody.
INSTANCE_ADMINS=

# --- Sign-in ------------------------------------------------------------------

# Lifetimes in minutes. The emailed code shares the link's.
LOGIN_TOKEN_TTL_MINUTES=30
SESSION_TTL_MINUTES=43200
# Wrong guesses before an emailed code is destroyed.
LOGIN_CODE_MAX_ATTEMPTS=5
# Requests per email address within the window: sign-in emails, code checks.
LOGIN_RATE_MAX=5
VERIFY_RATE_MAX=15
LOGIN_RATE_WINDOW_MINUTES=15

# --- Projects -----------------------------------------------------------------

# How a new account names its projects. Each user can change theirs in Settings.
# Only read by `make dev`. The compose files leave it out, because Compose reads
# the braces as its own variable syntax.
# DEFAULT_NAMING_PATTERN={year}-{conference|lower}-{paper|lower}
